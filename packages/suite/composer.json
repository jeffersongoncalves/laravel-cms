{
    "name": "jeffersongoncalves/laravel-cms",
    "description": "Umbrella meta-package bundling the full Laravel CMS ecosystem (core, media, menu).",
    "keywords": [
        "laravel",
        "cms",
        "umbrella",
        "bundle"
    ],
    "homepage": "https://github.com/jeffersongoncalves/laravel-cms",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Jefferson Gonçalves",
            "email": "gerson.simao.92@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "jeffersongoncalves/laravel-cms-core": "self.version",
        "jeffersongoncalves/laravel-cms-media": "self.version",
        "jeffersongoncalves/laravel-cms-menu": "self.version"
    },
    "require-dev": {
        "larastan/larastan": "^2.9|^3.0",
        "laravel/pint": "^1.0",
        "nunomaduro/collision": "^8.0",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "JeffersonGoncalves\\Cms\\Suite\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "JeffersonGoncalves\\Cms\\Suite\\Tests\\": "tests"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "JeffersonGoncalves\\Cms\\Suite\\CmsServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "format": "vendor/bin/pint",
        "analyse": "vendor/bin/phpstan analyse"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "support": {
        "issues": "https://github.com/jeffersongoncalves/laravel-cms/issues",
        "source": "https://github.com/jeffersongoncalves/laravel-cms"
    }
}
